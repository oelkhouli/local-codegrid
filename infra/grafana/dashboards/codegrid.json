{
  "uid": "codegrid-local",
  "title": "Local CodeGrid \u00b7 execution and recovery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "codegrid"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Completed jobs per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(codegrid_jobs_completed_total[5m]))",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Completion latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(histogram_quantile(0.50,sum by(le)(rate(codegrid_job_latency_seconds_bucket[5m]))),\"quantile\",\"p50\",\"\",\"\") or label_replace(histogram_quantile(0.95,sum by(le)(rate(codegrid_job_latency_seconds_bucket[5m]))),\"quantile\",\"p95\",\"\",\"\") or label_replace(histogram_quantile(0.99,sum by(le)(rate(codegrid_job_latency_seconds_bucket[5m]))),\"quantile\",\"p99\",\"\",\"\")",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Infrastructure failure fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(codegrid_jobs_completed_total{verdict=\"INFRA_ERROR\"}[5m])) / clamp_min(sum(rate(codegrid_jobs_completed_total[5m])),0.000001)",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Verdicts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(verdict)(rate(codegrid_jobs_completed_total[5m]))",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(codegrid_jobs_queued)",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Reserved execution slots",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(codegrid_reservations_slots)",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Reserved sandbox memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(codegrid_reservations_memory_bytes)",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Reserved CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(codegrid_reservations_cpu_millicores) / 1000",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Retries and stale protocol writes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(codegrid_jobs_retried_total[5m]))",
          "legendFormat": "Retries"
        },
        {
          "refId": "B",
          "expr": "sum(rate(codegrid_protocol_stale_total[5m]))",
          "legendFormat": "Stale writes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Worker JVM memory used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance)(jvm_memory_used_bytes{job=\"workers\"})",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Worker host load average",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "codegrid_worker_system_load",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Quarantine and pending outbox",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(codegrid_nodes_quarantined)",
          "legendFormat": "Quarantined nodes"
        },
        {
          "refId": "B",
          "expr": "max(codegrid_outbox_pending)",
          "legendFormat": "Pending outbox"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "Cold sandbox p95 by language",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,language)(rate(codegrid_sandbox_duration_seconds_bucket[5m])))",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{verdict}}{{language}}{{quantile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
